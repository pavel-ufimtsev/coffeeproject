APP_NAME=CoffeeProject
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://coffeeproject.localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=coffeeproject
DB_USERNAME=coffeeproject
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@coffeeproject.ru"
MAIL_FROM_NAME="Coffee Project"

# Resend (MAIL_MAILER=resend): API key from resend.com, with coffeeproject.ru verified there.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial admin account, created by `make seed-admin`.
# Remove ADMIN_PASSWORD once the account exists.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where contact form messages go.
SHOP_CONTACT_EMAIL=coffeeproject.ekb@gmail.com

# Admins must set up two-factor authentication before using /admin.
ADMIN_REQUIRE_TWO_FACTOR=true

# retailCRM (https://coffeeproject.retailcrm.ru). API key: Settings → Integration →
# API access keys. RETAILCRM_SITE is the store code; `make crm-check` lists them.
RETAILCRM_URL=https://coffeeproject.retailcrm.ru
RETAILCRM_API_KEY=
RETAILCRM_SITE=
# Send new orders to retailCRM (delivery "courier", payment "cash").
RETAILCRM_PUSH_ORDERS=false

# Checkout payment methods. Cash: pay the courier on delivery.
CHECKOUT_CASH_ENABLED=true

# T-Bank internet acquiring (card, SBP, T-Pay). TBANK_MODE picks the terminal: test or live.
# Terminal key and password: T-Business → Internet acquiring → Shops → Terminals.
# Set in the terminal settings: notifications https://www.coffeeproject.ru/api/tinkoff/webhook,
# success https://www.coffeeproject.ru/payment/success, fail https://www.coffeeproject.ru/payment/failed
CHECKOUT_TBANK_ENABLED=true
TBANK_MODE=test
TBANK_TEST_TERMINAL_KEY=
TBANK_TEST_PASSWORD=
TBANK_LIVE_TERMINAL_KEY=
TBANK_LIVE_PASSWORD=
# 54-ФЗ receipts via T-Bank's online cash register; switch on once a register is connected to the terminal.
TBANK_RECEIPTS=false
TBANK_FFD_VERSION=1.2
TBANK_TAXATION=usn_income
TBANK_VAT=none
TBANK_RECEIPT_PAYMENT_METHOD=full_payment

# CDEK pickup points at checkout (card payment only). Account and secure password: CDEK account → Интеграция.
# Only pickup points and prices are read, so the live account is fine locally too.
# Yandex keys (developer.tech.yandex.ru): "JavaScript API" for the map, with the site's domains in its
# HTTP Referer restriction, and "API Геокодера" for address lookups, which our server makes.
CDEK_ACCOUNT=
CDEK_PASSWORD=
CDEK_YANDEX_MAPS_KEY=
CDEK_YANDEX_GEOCODER_KEY=
# Pickup point map: widget (CDEK widget v4, Yandex JS API 3.0) or yandex21 (our map on JS API 2.1).
CDEK_MAP=widget

# Yandex.Metrica counter (the old site's counter, so history continues).
YANDEX_METRIKA_ID=47060055
