# CoffeeProject - Docker environment (copy to .env)

# Host user IDs so files created in src/ are owned by you.
# Set these to the output of `id -u` and `id -g` (`make init` does it for you).
HOST_UID=1000
HOST_GID=1000

# Host ports (chosen so CoffeeProject can run alongside ColdEmail/PitchMatch,
# except nginx on 80: change NGINX_PORT if another project is using it)
NGINX_PORT=80
MYSQL_PORT=3308
VITE_PORT=5175
MAILPIT_UI_PORT=8027

# MySQL (must match DB_* in src/.env)
DB_DATABASE=coffeeproject
DB_USERNAME=coffeeproject
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
